{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "effortLevel": "medium",
  "enabledPlugins": {
    "ui-ux-pro-max@ui-ux-pro-max-skill": false
  },
  "permissions": {
    "allow": ["Bash", "PowerShell", "Read", "Edit", "Write", "WebFetch", "WebSearch"],
    "deny": [
      "Read(./pnpm-lock.yaml)",
      "Read(**/migrations/meta/**)",
      "Edit(**/migrations/meta/**)",
      "Read(**/routeTree.gen.ts)",
      "Edit(**/routeTree.gen.ts)",
      "Read(**/dist/**)",
      "Read(**/.turbo/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-session.sh\"",
            "timeout": 600,
            "statusMessage": "Cloud session setup"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/test-guard.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/biome-format.mjs\"",
            "timeout": 30,
            "statusMessage": "Biome"
          }
        ]
      }
    ]
  }
}
