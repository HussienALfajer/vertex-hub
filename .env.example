# Copy to .env (git-ignored) or run `pnpm db:setup-local`, which creates it with a random password.
# The api and the worker both read this file. Every value here is a placeholder; commented lines
# show optional settings with their defaults or an example value (`apps/api/src/core/config/env.ts`,
# `apps/worker/src/core/config/env.ts`, `docs/deployment.md`).
NODE_ENV=development
LOG_LEVEL=debug

API_HOST=127.0.0.1
API_PORT=3000

WORKER_NAME=local

# Public origin of the web app; the API is reached under it at /api.
APP_URL=http://127.0.0.1:5173
# Signs session cookies. Required in production (e.g. `openssl rand -hex 32`); derived locally when unset.
# BETTER_AUTH_SECRET=replace-with-a-long-random-value

DATABASE_URL=postgres://vertex_hub:change-me@127.0.0.1:5432/vertex_hub
TEST_DATABASE_URL=postgres://vertex_hub:change-me@127.0.0.1:5432/vertex_hub_test
# Connections the API's pool may open (the tests set 4).
# DATABASE_POOL_MAX=10
# Whether the API works the pg-boss queues (ADR 0008); the tests set false.
# JOBS_ENABLED=true

# Uploaded files (F10). Leave it unset in development: the api and the worker then share
# apps/api/.data/files (each resolves its default from its own folder). Production: one absolute
# path outside the releases, the same for both.
# FILES_ROOT=/srv/example/files
# Serve files through nginx's internal location (X-Accel-Redirect); on by default in production.
# FILES_X_ACCEL=false
# DB-IP "IP to City Lite" database that locates sign-in addresses (F01B); optional.
# GEOIP_DB_PATH=/srv/example/geoip/dbip-city-lite.mmdb

# Email (F14, ADR 0028). 32 bytes, base64, the same for the api and the worker; required in
# production (`openssl rand -base64 32`), derived locally when unset.
# EMAIL_SECRET_KEY=replace-with-32-bytes-base64
# `smtp` sends; `log` (the default outside production) writes .eml files to EMAIL_LOG_DIR.
# EMAIL_TRANSPORT=log
# EMAIL_FROM=info@vertexmedia.pro
# EMAIL_LOG_DIR=.data/emails
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# TLS from the start (port 465); false upgrades with STARTTLS (port 587).
# SMTP_SECURE=true
# SMTP_USER=replace-with-the-smtp-user
# SMTP_PASSWORD=replace-with-the-smtp-password

# Web Push (F16, ADR 0036). Generate the pair once: `npx web-push generate-vapid-keys`.
# The API reads only the public key; without it push is unavailable and the app hides it.
# VAPID_PUBLIC_KEY=replace-with-the-public-key
# VAPID_PRIVATE_KEY=replace-with-the-private-key
# VAPID_SUBJECT=mailto:info@vertexmedia.pro
# `webpush` sends; `log` (the default outside production) writes payloads to PUSH_LOG_DIR.
# PUSH_TRANSPORT=log
# PUSH_LOG_DIR=.data/push
